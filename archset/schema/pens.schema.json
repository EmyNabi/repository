{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archset.dev/schema/pens.schema.json",
  "title": "Pen table",
  "description": "Line weight in mm per line role, per drawing scale. Changing a value here updates every drawing.",
  "type": "object",
  "required": ["id", "scales"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scale", "label", "detail", "weights"],
        "additionalProperties": false,
        "properties": {
          "scale": { "type": "integer", "minimum": 1, "description": "Denominator: 96 means 1:96 (1/8\" = 1'-0\")." },
          "label": { "type": "string" },
          "detail": { "enum": ["coarse", "medium", "fine"] },
          "weights": {
            "type": "object",
            "required": ["cut_outline", "cut_layer", "projection", "beyond", "hidden"],
            "additionalProperties": false,
            "properties": {
              "cut_outline": { "type": "number", "exclusiveMinimum": 0 },
              "cut_layer": { "type": "number", "exclusiveMinimum": 0 },
              "projection": { "type": "number", "exclusiveMinimum": 0 },
              "beyond": { "type": "number", "exclusiveMinimum": 0 },
              "hidden": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}

{
  "$comment": "The one operation set. The panel calls these over HTTP; Claude calls them as MCP tools with the same names and inputs. host=core runs without Rhino; host=rhino needs the plugin. Every mutating op is one undo step, logged with its author.",
  "version": 1,
  "operations": [
    {
      "name": "library.list",
      "host": "core",
      "mutates": false,
      "description": "List assemblies and templates in the project library, with total thickness.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "common.schema.json#/$defs/kind"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "assembly.get",
      "host": "core",
      "mutates": false,
      "description": "Read one assembly with its layers and computed total thickness.",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "assembly.create",
      "host": "core",
      "mutates": true,
      "description": "Add a new assembly to the project library.",
      "input": {
        "type": "object",
        "required": [
          "assembly"
        ],
        "properties": {
          "assembly": {
            "$ref": "assembly.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "assembly.rename",
      "host": "core",
      "mutates": true,
      "description": "Change an assembly's display name.",
      "input": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "assembly.set_layer",
      "host": "core",
      "mutates": true,
      "description": "Change one layer's material, thickness or flags by index. Fields left out are kept.",
      "input": {
        "type": "object",
        "required": [
          "id",
          "index"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "material": {
            "type": "string"
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "function": {
            "$ref": "common.schema.json#/$defs/function"
          },
          "core": {
            "type": "boolean"
          },
          "spacing": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cavity_fill": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "assembly.insert_layer",
      "host": "core",
      "mutates": true,
      "description": "Insert a layer at an index (exterior/top = 0).",
      "input": {
        "type": "object",
        "required": [
          "id",
          "index",
          "layer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "layer": {
            "$ref": "layer.schema.json"
          }
        }
      }
    },
    {
      "name": "assembly.remove_layer",
      "host": "core",
      "mutates": true,
      "description": "Remove the layer at an index. An assembly keeps at least one layer.",
      "input": {
        "type": "object",
        "required": [
          "id",
          "index"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "name": "assembly.move_layer",
      "host": "core",
      "mutates": true,
      "description": "Move a layer from one index to another.",
      "input": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "name": "assembly.delete",
      "host": "core",
      "mutates": true,
      "description": "Delete an assembly. Refused while any object is assigned to it.",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "template.list",
      "host": "core",
      "mutates": false,
      "description": "List templates with their parameters and the number of variants each can generate.",
      "input": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "template.preview",
      "host": "core",
      "mutates": false,
      "description": "Generate one variant from a template and parameters without saving it. Reports a matching known assembly if any.",
      "input": {
        "type": "object",
        "required": [
          "template"
        ],
        "additionalProperties": false,
        "properties": {
          "template": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "template.generate",
      "host": "core",
      "mutates": true,
      "description": "Generate a variant and add it to the library. Ratings are copied only from a matching known assembly; otherwise null (TODO-SOURCE).",
      "input": {
        "type": "object",
        "required": [
          "template"
        ],
        "additionalProperties": false,
        "properties": {
          "template": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "object.assign",
      "host": "core",
      "mutates": true,
      "description": "Assign an assembly to model objects by object ID. In Rhino this writes object user text and re-graphics the objects.",
      "input": {
        "type": "object",
        "required": [
          "objects",
          "assembly"
        ],
        "additionalProperties": false,
        "properties": {
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "assembly": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "object.clear",
      "host": "core",
      "mutates": true,
      "description": "Remove the assembly assignment from objects.",
      "input": {
        "type": "object",
        "required": [
          "objects"
        ],
        "additionalProperties": false,
        "properties": {
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "history.undo",
      "host": "core",
      "mutates": false,
      "description": "Undo the last change, whoever made it.",
      "input": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "history.redo",
      "host": "core",
      "mutates": false,
      "description": "Redo the last undone change.",
      "input": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "history.log",
      "host": "core",
      "mutates": false,
      "description": "The change log: sequence, operation, author (person or claude), summary.",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "selection.get",
      "host": "rhino",
      "mutates": false,
      "description": "Object IDs currently selected in Rhino, with their assigned assemblies.",
      "input": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "walls.from_curves",
      "host": "rhino",
      "mutates": true,
      "description": "Generate walls from curves with an assembly, location line, base and top level.",
      "input": {
        "type": "object",
        "required": [
          "curves",
          "assembly"
        ],
        "additionalProperties": false,
        "properties": {
          "curves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assembly": {
            "type": "string"
          },
          "location_line": {
            "type": "string"
          },
          "base_level": {
            "type": "string"
          },
          "top_level": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "query.run",
      "host": "rhino",
      "mutates": false,
      "description": "Run a structured query, e.g. walls where fire_hr >= 1 and level = L2. Returns object IDs.",
      "input": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "view.color_by",
      "host": "rhino",
      "mutates": false,
      "description": "Color the viewport by an attribute (assembly, fire_hr, kind). Display only; not an undo step.",
      "input": {
        "type": "object",
        "required": [
          "attribute"
        ],
        "properties": {
          "attribute": {
            "type": "string"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "view.isolate",
      "host": "rhino",
      "mutates": false,
      "description": "Isolate objects in the viewport. Display only.",
      "input": {
        "type": "object",
        "required": [
          "objects"
        ],
        "properties": {
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "volume.set",
      "host": "core",
      "mutates": true,
      "description": "Add or replace a closed volume with its faces. Elements rebuild from it.",
      "input": {
        "type": "object",
        "required": [
          "volume"
        ],
        "additionalProperties": false,
        "properties": {
          "volume": {
            "$ref": "volume.schema.json"
          }
        }
      }
    },
    {
      "name": "volume.remove",
      "host": "core",
      "mutates": true,
      "description": "Remove a volume; everything derived from it goes too.",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "face.tag",
      "host": "core",
      "mutates": true,
      "description": "Tag one face (e.g. storefront, curtain_wall, open) to override every other rule. A null tag clears it.",
      "input": {
        "type": "object",
        "required": [
          "volume",
          "face"
        ],
        "additionalProperties": false,
        "properties": {
          "volume": {
            "type": "string"
          },
          "face": {
            "type": "string"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "massing.set",
      "host": "core",
      "mutates": true,
      "description": "Set grade elevation (mm) and the pairs of volumes the host found intersecting.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "grade": {
            "type": "number"
          },
          "intersections": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    {
      "name": "elements.derive",
      "host": "core",
      "mutates": false,
      "description": "Explode all volumes into building elements by the current rules. Returns elements with the rule behind each, counts and issues.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "element.explain",
      "host": "core",
      "mutates": false,
      "description": "Say in one sentence why an element is what it is, which rule made it and which it overrode.",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "rule.list",
      "host": "core",
      "mutates": false,
      "description": "List the project's face or opening rules in precedence order.",
      "input": {
        "type": "object",
        "required": [
          "set"
        ],
        "additionalProperties": false,
        "properties": {
          "set": {
            "enum": [
              "faces",
              "openings"
            ]
          }
        }
      }
    },
    {
      "name": "rule.set",
      "host": "core",
      "mutates": true,
      "description": "Add or change one face or opening rule. Optionally place it before another rule.",
      "input": {
        "type": "object",
        "required": [
          "set",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "set": {
            "enum": [
              "faces",
              "openings"
            ]
          },
          "rule": {
            "type": "object"
          },
          "before": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "rule.remove",
      "host": "core",
      "mutates": true,
      "description": "Remove one face or opening rule.",
      "input": {
        "type": "object",
        "required": [
          "set",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "set": {
            "enum": [
              "faces",
              "openings"
            ]
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "session.list",
      "host": "core",
      "mutates": false,
      "description": "List sessions, newest first: date, time span, change count, starred count, authors.",
      "input": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "session.get",
      "host": "core",
      "mutates": false,
      "description": "The ordered record of one session (default: the latest): each change with time, author, request and operation.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "name": "change.star",
      "host": "core",
      "mutates": false,
      "description": "Mark or unmark a change for the session deck. Record metadata only; not an undo step.",
      "input": {
        "type": "object",
        "required": [
          "seq"
        ],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "starred": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "deck.make",
      "host": "core",
      "mutates": false,
      "description": "Build a deck from a session: one slide per starred change (all changes if none starred), each traced to its change.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}

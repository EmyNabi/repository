{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archset.dev/schema/opening-rules.schema.json",
  "title": "Opening rules",
  "description": "Assume an opening's kind from its proportion and location. First matching rule wins; a rule with no conditions is the fallback.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "sill_max": { "type": "number" },
            "sill_min": { "type": "number" },
            "height_min": { "type": "number" },
            "width_min": { "type": "number" },
            "width_max": { "type": "number" },
            "width_ratio_min": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opening width / face width." },
            "height_ratio_min": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opening height / face height." }
          }
        },
        "then": {
          "type": "object",
          "required": ["element"],
          "additionalProperties": false,
          "properties": { "element": { "type": "string" } }
        },
        "why": { "type": "string" }
      }
    }
  }
}
